# Skopíruj tento súbor ako ".env" (bez ".example") a vyplň skutočnými hodnotami.
# Presný postup, kde tieto hodnoty v Supabase/Anthropic nájdeš, je v návode "Navod_AI_Demo_Projekty_Claude_Code" (sekcie 2 a 3).

# Supabase — Settings -> Data API (alebo tlačidlo "Connect" v dashboarde) -> "API URL"
SUPABASE_URL=

# Supabase — Settings -> API Keys -> záložka "API Keys" (sb_secret_...) alebo "Legacy API Keys" (service_role)
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
